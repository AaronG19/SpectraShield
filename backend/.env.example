# Agent Security Platform - Environment Configuration
# Copy to .env and fill in your values

# --- Security ---
SECRET_KEY=change-this-to-a-random-64-char-string

# --- Database (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_security

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Threat Intelligence API Keys ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=

# --- Behavioral Detection ---
BEHAVIORAL_ANALYSIS_ENABLED=true

# --- ML Detection (requires scikit-learn) ---
ML_ENABLED=false

# --- Risk Score Thresholds (0-100) ---
RISK_SCORE_THRESHOLD_LOW=20
RISK_SCORE_THRESHOLD_MEDIUM=40
RISK_SCORE_THRESHOLD_HIGH=65
RISK_SCORE_THRESHOLD_CRITICAL=85

# --- Auto Response ---
AUTO_RESPONSE_ENABLED=true

# --- Correlation Time Window (seconds) ---
CORRELATION_TIME_WINDOW=3600

# --- Agent Settings ---
AGENT_POLL_INTERVAL=30
AGENT_HASH_INTERVAL=150
SYNC_INTERVAL=3600

# --- Webhook ---
WEBHOOK_URL=

# --- Agentic LLM Configuration ---
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_API_TIMEOUT=10
AGENTIC_LLM_ENABLED=true

